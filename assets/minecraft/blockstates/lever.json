{
  "multipart": [
    {
      "when": { "face": "floor", "facing": "north" },
      "apply": { "model": "block/halloween/spider", "y": 180}
    },
    {
      "when": { "face": "floor", "facing": "east" },
      "apply": { "model": "block/halloween/spider", "y": 270}
    },
    {
      "when": { "face": "floor", "facing": "south" },
      "apply": { "model": "block/halloween/spider"}
    },
    {
      "when": { "face": "floor", "facing": "west" },
      "apply": { "model": "block/halloween/spider", "y": 90}
    },
    {
      "when": { "face": "wall", "facing": "north" },
      "apply": { "model": "block/halloween/spider", "x": 90, "y": 0}
    },
    {
      "when": { "face": "wall", "facing": "east" },
      "apply": { "model": "block/halloween/spider", "x": 90, "y": 90 }
    },
    {
      "when": { "face": "wall", "facing": "south" },
      "apply": { "model": "block/halloween/spider", "x": 90, "y": 180 }
    },
    {
      "when": { "face": "wall", "facing": "west" },
      "apply": { "model": "block/halloween/spider", "x": 90, "y": 270 }
    },
    {
      "when": { "face": "ceiling", "facing": "north" },
      "apply": { "model": "block/halloween/spider", "x": 180 }
    },
    {
      "when": { "face": "ceiling", "facing": "east" },
      "apply": { "model": "block/halloween/spider", "x": 180, "y": 90 }
    },
    {
      "when": { "face": "ceiling", "facing": "south" },
      "apply": { "model": "block/halloween/spider", "x": 180, "y": 180 }
    },
    {
      "when": { "face": "ceiling", "facing": "west" },
      "apply": { "model": "block/halloween/spider", "x": 180, "y": 270 }
    }
  ]
}